#!/usr/bin/env php

<?php
$version = 'v1.1.1';

$options = getopt('hsva:r:d:', ['help', 'reset', 'version', 'allow:', 'remove:', 'domain:']);

$args = [
	'help' => false,
	'reset' => false,
	'version' => false,
	'allow' => [],
	'remove' => [],
	'domain' => null,
];

foreach($options as $option => $value) {
	switch($option) {
		case 'h':
		case 'help':
			$args['help'] = true;
			break;
		case 's':
		case 'reset':
			$args['reset'] = true;
			break;
		case 'v':
		case 'version': 
			$args['version'] = true;
			break;
		case 'a':
		case 'allow':
			if(gettype($value) === 'array') {
				$args['allow'] = array_merge($args['allow'], $value);
			} else {
				$args['allow'][] = $value;
			}
			break;
		case 'r':
		case 'remove':
			if(gettype($value) === 'array') {
				$args['remove'] = array_merge($args['remove'], $value);
			} else {
				$args['remove'][] = $value;
			}
			break;
		case 'd':
		case 'domain': 
			$args['domain'] = $value;
			break;
		default:
			break;
	}
}

if($args['version']) {
	version(false);
	exit;
}

if($args['help']) {
	msg('Help coming soon...', true, false);
	exit;
}

version();
msg();

if($args['reset']) {
	msg('Resetting config.json');
	if(file_exists('config.json')) {
		unlink('config.json');
	}
}

if(!file_exists('config.json')) {
    if(file_exists('config-example.json')) {
        copy('config-example.json', 'config.json');
    } else {
        $config = [
			'allowed_ips' => [],
			'domain' => null,
		];
        file_put_contents('config.json', json_encode($config, JSON_PRETTY_PRINT));
    }
}

$config = json_decode(file_get_contents('config.json'), true);

function allow(string $ip, bool $log = true): bool {
    $cmd = 'sudo ufw allow from {ip} to any port {port} proto {protocol}';

    $command = strtr($cmd, [
        '{ip}' => $ip,
        '{port}' => '22',
        '{protocol}' => 'tcp',
    ]);

    if(!check($ip)) {
        exec($command, $output);
        if(in_array('Rule added', $output) || in_array('Rule added (v6)', $output)) {
            if($log) {
                msg('[SUCCESS]', true, false);
            }
            return true;
        }

        if($log) {
            msg('[FAILED]', true, false);
        }

        msg('ERROR');
        foreach($output as $line) {
            msg($line);
        }
        msg();
        return false;
    }

    if($log) {
        msg('[SUCCESS]', true, false);
    }
    return true;
}

function check(string $ip): bool {
    return array_key_exists($ip, rules());
}

function rules(): array {
    $cmd = 'sudo ufw status numbered | grep -E "{rule_pattern}" | tr -s " " | sed -e "{trim_pattern}" | grep -E "{search_pattern}"';
    
    $command = strtr($cmd, [
        '{rule_pattern}' => '^\[',
        '{trim_pattern}' => 's/[ \t]$//g',
        '{search_pattern}' => '22/tcp ALLOW IN',
    ]);

    exec($command, $output);

    $rules = [];

    foreach($output as $rule) {
        preg_match('/^\[ *([0-9]+)\]/', $rule, $matches);
        $rules[str_replace($matches[0] . ' 22/tcp ALLOW IN ', '', $rule)] = (int)$matches[1];	
    }

    return $rules;
}

function removeIp(string $ip, bool $log = true): bool {
    $rules = rules();
    return remove($rules[$ip], $log);
}

function remove(int $rule, bool $log = true): bool {
    $cmd = 'sudo ufw --force delete {rule}';
    $command = strtr($cmd, [
        '{rule}' => $rule
    ]);
	
    exec($command, $output); 
	
    if(in_array('Rule deleted', $output) || in_array('Rule deleted (v6)', $output)) {
        if($log) {
            msg('[SUCCESS]', true, false);
        }
        return true;
    }

    if($log) {
        msg('[FAILED]', true, false);
    }

    msg('ERROR');
    foreach($output as $line) {
        msg($line);
    }
    msg();
    return false;
}

function msg(?string $message = null, bool $eol = true, bool $date = true): void {
    echo ($date ? '['.date('Y-m-d H:i:s').'] ' : '').$message.($eol ? PHP_EOL : '');
}	

function version(bool $date = true): void {
    global $version;

    msg('UFW Updater', true, $date);
    msg('Version '.$version, true, $date);
}

if(count($args['allow'])) {
	foreach($args['allow'] as $ip) {
		if(preg_match('/^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/', $ip)) {
			msg('Adding '.$ip.' to allow list');
			$config['allowed_ips'][] = $ip;
		} else {
			msg($ip.' is not a vaild IP address, skipping');
		}
	}
	file_put_contents('config.json', json_encode($config, JSON_PRETTY_PRINT));
}

if(count($args['remove'])) {
	foreach($args['remove'] as $ip) {
		if(preg_match('/^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/', $ip)) {
			msg('Removing '.$ip.' from allow list');
			$config['allowed_ips'] = array_values(array_filter($config['allowed_ips'], fn(string $item) => $item !== $ip));
		} else {
			msg($ip.' is not a valid IP address, skipping');
		}
	}
	file_put_contents('config.json', json_encode($config, JSON_PRETTY_PRINT));
}

if(!empty($args['domain'])) {
	msg('Updating domain to '.$args['domain']);
	$config['domain'] = $args['domain'];
	file_put_contents('config.json', json_encode($config, JSON_PRETTY_PRINT));
}

$config = json_decode(file_get_contents('config.json'), true);

msg('Checking existing allow listed IPs...');

foreach(rules() as $ip => $num) {
    msg('Currently allowed IP '.$ip);
    if(!in_array($ip, $config['allowed_ips'])) {
        msg('Removing not explictly allowed IP '.$ip.'  ', false);
        removeIp($ip);
    } else {
        msg($ip.' is allow listed in config.json  [SKIPPING]');
    }
}

msg();
msg('Adding all allow listed IPs');
foreach($config['allowed_ips'] as $ip) {
    msg('Adding IP '.$ip.'  ', false);
    allow($ip);
}

msg();

if($config['domain']) {
    msg('Getting IP from '.$config['domain']);

    exec(sprintf('dig %s A +short', $config['domain']), $output);

    $ip = $output[0];

    msg($config['domain'].' => '.$ip);
    msg();

    msg('Adding IP '.$ip.'  ', false);
    allow($ip);
    msg();
}

msg('Completed');
